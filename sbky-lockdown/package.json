{
  "name": "sbky-lockdown-alert",
  "version": "0.1.0",
  "description": "SBKY school lockdown alert desktop client",
  "main": "main.js",
  "private": true,
  "scripts": {"start":"electron ."},
  "devDependencies": {"electron":"38.1.2","electron-builder":"26.0.12"},
  "build": {
    "appId": "school.sbky.lockdown",
    "productName": "SBKY Lockdown Alert",
    "asar": true,
    "files": ["main.js","preload.js","alert-preload.js","index.html","renderer.js","alert.html","alert.js","assets/**/*","README.txt"],
    "win": {"target":["nsis"],"artifactName":"SBKY-Lockdown-Setup-${version}.${ext}"},
    "mac": {"target":["dmg"],"category":"public.app-category.utilities","artifactName":"SBKY-Lockdown-Mac-${version}.${ext}"},
    "nsis": {"oneClick":true,"perMachine":false}
  }
}